# Keep the native-wheel Python overlay, not a second full vLLM build checkout.
/vendor/easysteer-runtime.json
/vendor/easysteer-vllm/*
!/vendor/easysteer-vllm/vllm/
!/vendor/easysteer-vllm/LICENSE
!/vendor/easysteer-vllm/README.md
!/vendor/easysteer-vllm/pyproject.toml

